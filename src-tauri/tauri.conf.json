{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LoadLoom",
  "identifier": "com.agentic.loadloom",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LoadLoom · 高并发打流控制台",
        "width": 1240,
        "height": 820,
        "minWidth": 980,
        "minHeight": 660,
        "center": true,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "shadow": true,
        "theme": null,
        "zoomHotkeysEnabled": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
