# 统一仓库内换行：文本一律 LF 入库，避免 Windows/Linux 混用产生整文件级 diff。
* text=auto eol=lf

*.rs    text eol=lf
*.toml  text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf

# Windows 脚本保留 CRLF
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# 二进制：禁止任何文本化处理
*.png   binary
*.ico   binary
*.icns  binary
*.exe   binary
*.dll   binary
*.msi   binary
*.pdb   binary

# 生成的锁文件不参与语言统计
Cargo.lock        linguist-generated=true
package-lock.json linguist-generated=true
