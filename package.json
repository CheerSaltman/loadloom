{
  "name": "loadloom",
  "private": true,
  "version": "0.4.7",
  "type": "module",
  "description": "LoadLoom — 原生桌面打流控制台（Tauri v2 + React + Tailwind）",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "pt:test": "cd sidecars/loadloom-pt && go test ./...",
    "pt:vet": "cd sidecars/loadloom-pt && go vet ./...",
    "pt:build": "go build -C sidecars/loadloom-pt -trimpath -ldflags=\"-s -w\" -o ../../src-tauri/binaries/loadloom-pt-x86_64-pc-windows-msvc.exe .",
    "tauri": "tauri",
    "desktop:dev": "npm run pt:build && tauri dev",
    "desktop:build": "npm run pt:build && tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "clsx": "^2",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vite": "^8"
  }
}
